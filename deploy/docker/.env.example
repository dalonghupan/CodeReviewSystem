# ============================================================
# CR-System 开发环境配置（docker-compose 用）
# ============================================================

# --- 数据库 ---
POSTGRES_USER=cr_system
POSTGRES_PASSWORD=cr_dev_password
POSTGRES_DB=cr_system
POSTGRES_DSN=postgres://cr_system:cr_dev_password@postgres:5432/cr_system?sslmode=disable
POSTGRES_READ_DSN=postgres://cr_system:cr_dev_password@postgres:5432/cr_system?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# --- RocketMQ ---
ROCKETMQ_NAMESRV=rocketmq-namesrv:9876

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Jaeger ---
OTEL_ENDPOINT=jaeger:4317

# --- Keycloak ---
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_CLIENT_SECRET=dev-client-secret
# token iss 由 Keycloak 前端地址（KC_HOSTNAME）决定，须与 JWTAuth issuer 校验一致
KEYCLOAK_ISSUER=http://localhost:8080/realms/cr-system

# --- Git OAuth（开发环境用占位值，联调时替换） ---
GIT_OAUTH_REDIRECT=http://localhost:8002/api/v1/oauth
GITLAB_BASE_URL=https://gitlab.com
GITLAB_CLIENT_ID=dev-gitlab-client-id
GITLAB_CLIENT_SECRET=dev-gitlab-client-secret
GITEE_CLIENT_ID=dev-gitee-client-id
GITEE_CLIENT_SECRET=dev-gitee-client-secret
GITHUB_CLIENT_ID=dev-github-client-id
GITHUB_CLIENT_SECRET=dev-github-client-secret

# --- 安全 ---
TOKEN_AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Sonar ---
SONAR_BASE_URL=http://sonarqube:9000
SONAR_TOKEN=dev-sonar-token
